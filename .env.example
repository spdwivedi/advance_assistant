# ==============================================================================
# ADVANCE ASSISTANT OS v6.0 - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and configure keys/endpoints for your environment.
# Note: NEVER commit your actual .env file or production keys to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Cloud Model API Keys
# ------------------------------------------------------------------------------
# Google AI Studio API Key for Gemini 2.5/3.6 Flash & Gemini 2.5 Pro models
GEMINI_API_KEY=AIzaSyYourActualGoogleGeminiKeyHere1234567

# Groq Cloud API Key for ultra-high-throughput LPU models (Qwen 2.5 Coder, Llama 3.3)
GROQ_API_KEY=gsk_yourActualGroqCloudLpuKeyHereABC1234567890

# ------------------------------------------------------------------------------
# 2. Local Model & Testing Infrastructure
# ------------------------------------------------------------------------------
# Local Ollama daemon endpoint (default: http://127.0.0.1:11434)
OLLAMA_API_BASE=http://127.0.0.1:11434
OLLAMA_HOST=http://127.0.0.1:11434

# Path to offline model benchmarks and capability testing repository
TESTING_SUITE_ROOT=/mnt/d/Project_Files/Ollama_Models_Testing

# Path to local Aider binary for interactive pair-programming CLI bridge
AIDER_BIN=/home/assistantuser/.local/bin/aider

# ------------------------------------------------------------------------------
# 3. Workflow Automation & Tool Integrations
# ------------------------------------------------------------------------------
# N8N automation webhook URL for triggering autonomous task workflows
N8N_WEBHOOK_URL=http://localhost:5678/webhook/advance-assistant-task

# RooCode / Cline bridge IPC socket connection string
ROOCODE_SOCKET=/tmp/roocode_ipc.sock

# Antigravity Model Context Protocol (MCP) server port
ANTIGRAVITY_MCP_PORT=8080
MCP_SERVER_URL=http://localhost:8080/mcp

# ------------------------------------------------------------------------------
# 4. Token Governor & Pacing Diagnostics
# ------------------------------------------------------------------------------
# Set to 'true' in CI/test environments to disable physical pacing sleep cycles
DISABLE_PACING_SLEEP=false
